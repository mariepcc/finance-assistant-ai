# Skopiuj do backend/.env (plik .env jest w .gitignore). Wartości poniżej pasują do `npx supabase start`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Tylko dla projektów z sekretem HS256 (starsze klucze JWT Supabase); inaczej zostaw puste (JWKS).
SUPABASE_JWT_SECRET=
# Testy tworzą i kasują tę bazę przy każdym uruchomieniu.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/finance_test
