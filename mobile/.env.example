# Skopiuj do mobile/.env. Zmienne EXPO_PUBLIC_* trafiają do aplikacji, więc NIE umieszczaj tu sekretów.
# Na fizycznym telefonie zamiast 127.0.0.1 podaj adres IP komputera w sieci lokalnej (np. 192.168.1.20).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Klucz publiczny (anon / publishable) z wyniku `npx supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
